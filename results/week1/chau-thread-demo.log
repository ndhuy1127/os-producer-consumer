Temporary failure injection only; wrapper is outside the repository and is not part of the demo:
#include <errno.h>
#include <pthread.h>
#include <stdlib.h>

int __real_pthread_create(pthread_t *, const pthread_attr_t *,
                          void *(*)(void *), void *);
int __wrap_pthread_create(pthread_t *thread, const pthread_attr_t *attr,
                          void *(*routine)(void *), void *argument)
{
    static int calls;
    const char *value = getenv("FAIL_CREATE_AT");
    int fail_at = value == NULL ? 3 : atoi(value);
    if (++calls == fail_at) {
        return EAGAIN;
    }
    return __real_pthread_create(thread, attr, routine, argument);
}


